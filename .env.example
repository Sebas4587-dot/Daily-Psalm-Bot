# Supabase PostgreSQL connection string (server-side only).
# Copy the connection string provided by your Supabase project, including user,
# password, host, database and SSL options. Never use a public/anon API key here.
DATABASE_URL=
HOST=127.0.0.1
API_PORT=8080
WEB_PORT=20874
BASE_PATH=/

# Same Supabase project as DATABASE_URL. Settings > API Keys > Publishable key.
# These two values are public; never put a secret/service_role key here.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=
# Legacy public anon key can be used instead of SUPABASE_PUBLISHABLE_KEY.
# SUPABASE_ANON_KEY=

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Certificate downloaded from Supabase Database Settings > SSL Configuration.
# Relative paths are resolved from the project root.
# DATABASE_SSL_CA_FILE=./prod-ca-2021.crt

# Leave empty locally: OAuth uses http://127.0.0.1:20874 with pnpm dev.
# Production: canonical HTTPS origin, without a path. Used at runtime for OAuth
# callbacks and API origin checks; no frontend rebuild is needed to set it.
# APP_ORIGIN=https://your-domain.example

# Public privacy contact address, displayed at /privacidad (no login required).
# Set a real address you manage. Empty/invalid values display no email address.
# Read at server startup; this address is intentionally public.
CONTACT_EMAIL=

# Recommendations link to the Nueva Versión Internacional (NVI).
# Optional: an API.Bible key and an NVI edition ID you have access to enable
# exact passage text inside the app. Without them the card shows commentary
# and a link to read the actual NVI passage, without fabricated quotations.
BIBLE_API_KEY=
BIBLE_ID_NVI=
